# =============================================================================
# AI SaaS Factory — environment configuration
# Copy to .env and adjust. All values are optional; sensible defaults apply.
# =============================================================================

# --- GitHub / Copilot auth -------------------------------------------------
# The Copilot SDK uses your logged-in GitHub CLI session by default.
# Run once:  gh auth login   then:  gh auth refresh --scopes copilot
# Optionally pin an explicit token (takes priority over the logged-in user):
# GITHUB_TOKEN=

# GitHub account/org that generated repos are created under (default: the
# authenticated user). Example: my-org
FACTORY_GITHUB_OWNER=

# Repo visibility for generated apps: private | public | internal
FACTORY_REPO_VISIBILITY=private

# --- Model routing ---------------------------------------------------------
# Override the model family preferences defined in config/model-routing.json.
# FACTORY_MODEL_DEEP=claude-opus-4.8
# FACTORY_MODEL_FAST=claude-sonnet-5

# --- Concurrency -----------------------------------------------------------
# Max parallel builder sub-agents.
FACTORY_MAX_PARALLEL=4

# --- Paths -----------------------------------------------------------------
# Where run state is stored and where generated app workspaces are created.
FACTORY_DATA_DIR=.factory
FACTORY_WORKSPACES_DIR=workspaces

# --- Web dashboard ---------------------------------------------------------
FACTORY_WEB_PORT=7788
FACTORY_WEB_HOST=127.0.0.1

# --- Autonomy --------------------------------------------------------------
# Gates that require human approval: comma-separated stage names.
# Defaults to requirements,release (after requirements + before push).
FACTORY_GATES=requirements,release

# --- "Wow" (differentiating) features --------------------------------------
# Propose best-in-class features that peers lack during requirements.
FACTORY_WOW=true
# How many top-ranked wow features to auto-include when you don't pick a subset.
FACTORY_WOW_COUNT=3

# --- Compliance-by-design --------------------------------------------------
# Default compliance profiles applied to every build (override per run with
# `new --compliance ...`). Options: pci-dss,hipaa,soc2,gdpr,iso27001
FACTORY_COMPLIANCE=

# --- Pipeline stages -------------------------------------------------------
# Generate CI/CD + IaC + repo hygiene in the delivery stage.
FACTORY_DELIVERY=true
# Score the finished app against a definition-of-done in the release stage
# (now derived from deterministic signals; the LLM only writes the narrative).
FACTORY_ACCEPTANCE=true

# --- Deployment scale --------------------------------------------------------
# Default deployment scale profile: startup | growth | scale
# (see config/deployment-profiles.json). Override per run with `new --scale`.
FACTORY_SCALE=startup

# --- Business-layer SaaS capabilities --------------------------------------
# Default capabilities every build ships with (override per run with
# `new --saas ...`). Options (see config/saas-capabilities.json):
#   billing,multitenancy,growth,support,deepQa,provenance,continuousDelivery
FACTORY_SAAS=

# --- Day-2 operations & self-improvement -----------------------------------
# Land operate/fix/sprint changes via a pull request instead of pushing to main.
FACTORY_PR_MODE=false
# Retry a failed agent task once on the deep model before failing (self-improve).
FACTORY_ESCALATE=true

# --- Deterministic verification & security fail-closed ----------------------
# Boot the app + poll health + run the test suite for real during verify.
FACTORY_VERIFY=true
# Fail the security gate when ZERO scanners actually ran (fail-closed). When
# false, a scanner-less run passes but is loudly marked "security NOT verified".
FACTORY_REQUIRE_SCANNERS=false

# --- Test-quality gates (coverage + mutation) --------------------------------
# Minimum line-coverage percentage (0 = measure & report only, no gate).
FACTORY_MIN_COVERAGE=0
# Hard-fail acceptance when coverage is below the floor.
FACTORY_REQUIRE_COVERAGE=false
# Run mutation testing during verify (opt-in; slow; needs mutmut/stryker).
FACTORY_MUTATION=false
# Minimum mutation score percentage when mutation testing runs.
FACTORY_MIN_MUTATION_SCORE=0

# --- Live-URL DAST (dynamic security against the running app) -----------------
# Run an OWASP ZAP baseline scan against the deployed preview URL (needs Docker
# + FACTORY_DEPLOY=true so there is a live URL to scan).
FACTORY_DAST=false
# Container image used for the DAST scan.
FACTORY_DAST_IMAGE=ghcr.io/zaproxy/zaproxy:stable
# Hard-fail acceptance when the live-URL DAST scan fails.
FACTORY_REQUIRE_DAST=false

# --- Cloud deploy + live smoke (the true definition of done) -----------------
# Target cloud for the optional ephemeral deploy + live URL smoke: azure | aws | none
FACTORY_CLOUD=azure
# Actually deploy during the delivery stage and probe the live URL. Requires the
# cloud tooling (azd for Azure; copilot/sam/aws for AWS) — see `factory doctor`.
FACTORY_DEPLOY=false
# Override the deploy command (else derived from FACTORY_CLOUD).
# FACTORY_DEPLOY_CMD=azd up --no-prompt
# Tear the ephemeral environment down after the live smoke.
FACTORY_DEPLOY_EPHEMERAL=true

# --- Isolation, budgets & queue ---------------------------------------------
# Build each workstream in its own git worktree (true parallel isolation).
FACTORY_WORKTREES=true
# Hard per-task token ceiling (0 = unlimited); flags runaway tasks.
FACTORY_MAX_TOKENS_PER_TASK=0
# Wall-clock budget for a whole run in seconds (0 = unlimited). Cost/safety cap.
FACTORY_MAX_RUN_SECONDS=0
# Optional HARD per-task timeout in seconds (0 = rely on the stall watchdog).
# Prefer the watchdog below: a hard clock kills healthy long turns; the SDK
# timeout does not even abort the agent, it only stops us waiting.
FACTORY_MAX_TASK_SECONDS=0
# Stall watchdog: abort a turn after this many seconds with NO activity of any
# kind (no tool call, token, or reasoning). Progress — not elapsed time — is the
# liveness signal. 0 disables. A working agent emits events constantly.
FACTORY_STALL_INACTIVITY_SECONDS=300
# Loop guard: abort when the SAME tool call (name+args) repeats this many times
# in a row with no other progress — the signature of a stuck agent. 0 disables.
FACTORY_STALL_LOOP_THRESHOLD=10
# Run a cheap estimate before building and abort if it already blows FACTORY_MAX_USD.
FACTORY_PREFLIGHT=false
# Visibility timeout for a claimed job before another worker may reclaim it (ms).
FACTORY_JOB_VISIBILITY_MS=1800000

# --- Testing / CI ------------------------------------------------------------
# Skip real GitHub repo creation/push (used by the offline pipeline test).
FACTORY_OFFLINE=false

# --- Discovery & design agents ----------------------------------------------
# Front-of-pipeline discovery: domain researcher + pain-point/JTBD + PM backlog.
FACTORY_DISCOVERY=true
# Interrogate the vague one-line idea into a precise brief with explicit
# assumptions before requirements (self-answers under --yes; a human can
# override via the requirements "revise" gate).
FACTORY_INTERROGATOR=true
# Produce a DESIGN.md design system before the frontend is built.
FACTORY_DESIGN=true
# Screenshot + design-critique loop after the app boots (opt-in; needs Playwright).
FACTORY_VISUAL_QA=false
# Microcopy/brand polish pass in the release stage (opt-in; evidence-gated).
FACTORY_COPY=false
# Generate N candidate architectures and pick the best (1 = off).
FACTORY_BEST_OF=1
# Run a proposer/critic debate on the architecture.
FACTORY_ARCH_CRITIQUE=false

# --- Cost & token budgeting ------------------------------------------------
# Abort a run if it exceeds these (0 = unlimited).
FACTORY_MAX_TOKENS=0
FACTORY_MAX_USD=0
# Blended USD price per 1M tokens used for cost estimates.
FACTORY_USD_PER_MTOK=6

# --- Telemetry (optional) --------------------------------------------------
# OTLP endpoint for factory + generated-app OpenTelemetry traces.
# FACTORY_OTLP_ENDPOINT=http://localhost:4318
